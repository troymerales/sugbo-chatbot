# Copy to .streamlit/secrets.toml and fill in. secrets.toml is git-ignored.
# On Streamlit Community Cloud, paste these into App → Settings → Secrets.
# assistant/bootstrap.py copies each key into os.environ, so the names match .env.example exactly.

# --- Gemini (chatbot answers + SOAP generation) ---
# Required unless LLM_BACKEND = "mock" (offline mode).
GEMINI_API_KEY = "your-gemini-key"
# GEMINI_MODEL = "gemini-3.6-flash"

# --- Speech-to-text transcription ---
# Deployed: point to the hosted ASR endpoint (see deploy/asr-space/DEPLOY.md)
# Local dev with transformers installed: omit this, Whisper runs in-process
ASR_API_URL = "https://<user>-sugbodoc-asr.hf.space/transcribe"
# ASR_AUTH_TOKEN = "<random string>"   # only if the Space is private

# --- Jira ticket creation ---
JIRA_BASE_URL = "https://your-domain.atlassian.net"
JIRA_EMAIL = "you@example.com"
JIRA_API_TOKEN = "your-atlassian-api-token"
JIRA_PROJECT_KEY = "PROJ"
JIRA_ISSUE_TYPE = "Task"

# --- Chat-log persistence (optional but recommended for cloud) ---
# Without this: logs go to local JSONL (wiped on Streamlit Cloud reboot).
# With this: conversations persist to Supabase PostgreSQL chat_logs table.
# Use the Session pooler string (not the IPv6-only direct connection):
#   postgresql://postgres.<ref>:<pass>@aws-0-<region>.pooler.supabase.com:5432/postgres
# DATABASE_URL = "postgresql://..."

# --- Optional features ---
# LLM_BACKEND = "mock"          # Offline mode (no keys, deterministic responses)
# VERIFY_ANSWERS = "0"          # Skip the answer verification pass (faster, half quota)
# USE_RAG = "1"                 # Retrieve only top-K relevant docs (semantic search)
# RAG_TOP_K = "6"               # Number of docs to retrieve
