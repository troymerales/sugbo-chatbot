# Copy to .streamlit/secrets.toml and fill in. secrets.toml is git-ignored.
# On Streamlit Community Cloud, paste these into  App -> Settings -> Secrets
# (same TOML). assistant/bootstrap.py copies each key into os.environ, so the
# names match .env.example exactly.

# --- Gemini (required unless LLM_BACKEND = "mock") ---
# One key powers the chatbot AND the SOAP note / extract / review steps.
# (Transcription does NOT use Gemini — see HF_TOKEN below.)
GEMINI_API_KEY = "your-gemini-key"
# GEMINI_MODEL = "gemini-3.6-flash"          # chatbot answer model + SOAP model

# Offline mode — canned answers + a canned transcript, no key, no quota.
# LLM_BACKEND = "mock"

# Keep the chatbot's verification pass on (recommended) or trade it for speed.
# VERIFY_ANSWERS = "1"

# --- Speech-to-text (Consultation Transcript page) ---
# The fine-tuned checkpoint troxyz1268/whisper-small-bisaya via the Hugging Face
# Inference API. REQUIRED for transcription.
HF_TOKEN = "hf_xxx"
# BISAYA_WHISPER_MODEL_ID = "troxyz1268/whisper-small-bisaya"
# HF_INFERENCE_URL = "https://api-inference.huggingface.co/models/"   # or a dedicated Endpoint
# BISAYA_DB_PATH = "soap_notes.db"            # SOAP notes SQLite (ephemeral on Community Cloud)

# --- Jira (Atlassian Cloud) — outbound ticket creation ---
JIRA_BASE_URL = "https://your-domain.atlassian.net"
JIRA_EMAIL = "you@example.com"
JIRA_API_TOKEN = "your-atlassian-api-token"
JIRA_PROJECT_KEY = "KAN"
JIRA_ISSUE_TYPE = "Task"

# --- Chat-log persistence (recommended for the deployed app) ---
# Without this, chat logs go to a local file that Community Cloud wipes on every
# reboot. With it, finished conversations land in the `chat_logs` table and the
# analytics / eval loop keeps working. Use Supabase's *Session pooler* string
# (Project Settings -> Database -> Connection string -> Session pooler), NOT the
# IPv6-only direct host. Run `python -m api.db_init` once after setting it.
# DATABASE_URL = "postgresql://postgres.<ref>:<pass>@aws-0-<region>.pooler.supabase.com:5432/postgres"
