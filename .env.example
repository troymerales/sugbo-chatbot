# --- Gemini (chatbot answers + SOAP generation) ---
GEMINI_API_KEY=your-gemini-key

# Optional: override the default LLM model
# GEMINI_MODEL=gemini-3.6-flash

# --- Speech-to-text (Consultation Transcript page) ---
# Transcription uses the fine-tuned checkpoint: troxyz1268/whisper-small-bisaya
#
# LOCAL development: install `transformers` + `torch` to run Whisper in-process
#   (no config needed). The app automatically detects and uses local Whisper.
#
# DEPLOYED (Streamlit Community Cloud): point to a hosted ASR endpoint.
#   See deploy/asr-space/DEPLOY.md for the free HF Space setup.
# ASR_API_URL=https://<user>-sugbodoc-asr.hf.space/transcribe
# ASR_AUTH_TOKEN=                          # only if the Space is private

# Optional: override the Whisper model ID
# BISAYA_WHISPER_MODEL_ID=troxyz1268/whisper-small-bisaya
# BISAYA_ASR_LANGUAGE=tl                   # Whisper language code (Cebuano -> Tagalog)

# Optional: path to the SOAP notes SQLite database
# BISAYA_DB_PATH=soap_notes.db

# Optional: path to the evaluation fixtures directory
# BISAYA_TRIAL_DIR=trial

# --- Chat persistence (optional) ---
# Unset (default): chat logs go to logs/chats.jsonl locally.
# Set: chat logs persist to Supabase PostgreSQL `chat_logs` table.
#
# Use the Supabase Session pooler string (Dashboard -> Project Settings ->
# Database -> Connection string -> Session pooler), NOT the direct IPv6 connection.
#   postgresql://postgres.<ref>:<pass>@aws-0-<region>.pooler.supabase.com:5432/postgres
# DATABASE_URL=postgresql://user:pass@host/db

# --- Jira ticket creation (optional) ---
# Omit to disable. Create an API token at https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=your-atlassian-api-token
JIRA_PROJECT_KEY=PROJ
JIRA_ISSUE_TYPE=Task

# Optional: custom field names for the Jira ticket form
# JIRA_SUBMITTER_FIELD=Submitter
# JIRA_SUBMITTER_EMAIL_FIELD=Submitter Email
# JIRA_SUBJECT_FIELD=Subject

# --- Retrieval-Augmented Generation (optional) ---
# 0 (default): full documentation in every answer prompt.
# 1: retrieve only the top-RAG_TOP_K relevant sections (semantic search).
# USE_RAG=0
# RAG_TOP_K=6

# --- Answer verification (optional) ---
# 1 (default): second LLM pass verifies every answer claim against the docs.
# 0: skip verification (faster, half the quota, no hallucination check).
# VERIFY_ANSWERS=1

# --- Chatbot tuning (optional) ---
# QUESTIONS_BEFORE_TICKET=3
# DEDUP_SIMILARITY_THRESHOLD=0.82

# --- Offline mode (optional) ---
# LLM_BACKEND=mock    # Deterministic offline mode (no keys, no quota, canned responses)
