# --- Gemini (required) ---
GEMINI_API_KEY=your-gemini-key

# Optional model overrides (defaults shown). JUDGE must differ from the answer
# model or the eval score is not trustworthy.
# GEMINI_MODEL=gemini-3.6-flash
# GEMINI_UTILITY_MODEL=gemini-3.6-flash
# GEMINI_JUDGE_MODEL=gemini-pro-latest
# GEMINI_EMBED_MODEL=gemini-embedding-001

# --- Jira (Atlassian Cloud) — outbound ticket creation ---
# Create an API token at https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=your-atlassian-api-token
JIRA_PROJECT_KEY=KAN
JIRA_ISSUE_TYPE=Task
# Plain-text custom fields the assistant fills with the chat submitter's
# identity (the `reporter` system field can't take a non-user name/email).
# Looked up by name at runtime, skipped if they don't exist.
# JIRA_SUBMITTER_FIELD=Submitter
# JIRA_SUBMITTER_EMAIL_FIELD=Submitter Email
# JIRA_SUBJECT_FIELD=Subject

# --- Database (FastAPI backend only — api/service.py) ---
# Unset  -> sessions kept in memory, chat logs written to logs/chats.jsonl.
# Set    -> sessions in the `conversations` table, finished chats in `chat_logs`.
# Run `python -m api.db_init` once after setting this. A bare postgresql:// URL
# is fine — db.py pins whichever driver is installed (psycopg v3 or psycopg2).
# DATABASE_URL=postgresql://user:pass@localhost:5432/sugbodoc
#
# Supabase: use the *Session pooler* string (Dashboard -> Project Settings ->
# Database -> Connection string -> Session pooler), NOT the direct connection.
# The direct host db.<ref>.supabase.co is IPv6-only; the pooler is IPv4:
#   postgresql://postgres.<ref>:<pass>@aws-0-<region>.pooler.supabase.com:5432/postgres
# DB_ECHO=0

# --- Retrieval (optional) ---
# 0 (default): the whole documentation goes in the answer prompt every turn.
# 1: retrieve only the top-RAG_TOP_K relevant sections (embedding cosine). The
#    verification pass and eval judge still use the full docs, so both modes are
#    interchangeable and the eval scorecard records which one ran.
# USE_RAG=0
# RAG_TOP_K=6

# --- Behaviour tuning (optional) ---
# QUESTIONS_BEFORE_TICKET=3
# DEDUP_SIMILARITY_THRESHOLD=0.82
