# Keep the build context small and — more importantly — keep secrets and private
# material OUT of the image. Anything listed here is never sent to the Docker
# daemon, so it cannot end up in a layer.

# secrets / local config
.env
.env.*
!.env.example
.mcp.json
.claude/

# private study material (personal learning notes + the cloud lab)
study/

# private knowledge base + prompt (the image falls back to the committed
# docs/SugboDoc-Documentation.sample.md; the full doc is added on Render as a
# Secret File at runtime, never baked in)
docs/SugboDoc-Documentation.md
docs/system-prompt.md
docs/homepage-reference.png

# runtime / generated
logs/
doc_proposals/
__pycache__/
*.pyc
*.sqlite
*.db
.pytest_cache/
.ipynb_checkpoints/
*.egg-info/

# vcs / tooling / docs that don't belong in a runtime image
.git/
.github/
.gitignore
tests/
evaluation/eval_generated.jsonl
evaluation/eval_scorecard.*
tickets.csv
chapters.txt
transcript.txt
